{
  "name": "campus-signal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --environment node",
    "dev:backend": "tsx watch backend/src/server.ts",
    "build:backend": "tsc -p tsconfig.backend.json",
    "start:backend": "node backend/dist/server.js",
    "db:migrate": "tsx backend/src/db/migrate.ts",
    "test:backend": "vitest run --environment node backend/tests"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jose": "^6.0.11",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "typescript": "~5.7.2",
    "tsx": "^4.19.4",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  }
}
